  "tutorialNotes": [
    {
      "startFrame": 0,
      "endFrame": 240,
      "title": "GIVE THEM A REASON",
      "body": "Two friends, one promise: cross together.",
      "command": "DEZ2 \u00b7 LIVE \u00b7 Sonic + Tails"
    },
    {
      "startFrame": 240,
      "endFrame": 535,
      "title": "LET A MOVE CHANGE THINGS",
      "body": "Sonic rushes ahead. Tails calls him back.",
      "command": "MOVE_TO .65 \u00b7 JUMP hold 20"
    },
    {
      "startFrame": 535,
      "endFrame": 780,
      "title": "MAKE THE REPLY VISIBLE",
      "body": "A crouch gives the apology a beat. Then Sonic returns.",
      "command": "CROUCH 45 \u00b7 return at 660"
    },
    {
      "startFrame": 780,
      "endFrame": 1065,
      "title": "CHOOSE THE SHARED ARRIVAL",
      "body": "Tails can fly. Sonic chooses company over speed.",
      "command": "WAIT ON_OBJECT \u00b7 timeout 180"
    },
    {
      "startFrame": 1065,
      "endFrame": 1240,
      "title": "COUNT INTO THE JUMP",
      "body": "The final word meets takeoff.",
      "command": "Three! at 1135\u20131140 \u00b7 jump 1141"
    },
    {
      "startFrame": 1240,
      "endFrame": 1560,
      "title": "WATCH THE CONSEQUENCE",
      "body": "Both board the lift. Native contact carries the last reply.",
      "command": "ON_OBJECT 166 \u00b7 frames 1199/1204"
    }
