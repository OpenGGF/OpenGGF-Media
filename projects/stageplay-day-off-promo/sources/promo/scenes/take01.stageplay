-724504,"nameArgb":-8408321,"panelArgb":-267379654,"borderArgb":-12751648,"padding":8,"decorationAsset":"decor/sonic.png","decorationBorder":6,"pointer":true},{"id":"knuckles","textArgb":-724504,"nameArgb":-34166,"panelArgb":-265678824,"borderArgb":-2609072,"padding":8,"decorationAsset":"decor/knuckles.png","decorationBorder":6,"pointer":true},{"id":"tails","textArgb":-724504,"nameArgb":-15526,"panelArgb":-265675252,"borderArgb":-1007584,"padding":8,"decorationAsset":"decor/tails.png","decorationBorder":6,"pointer":true}],"dialogue":[{"id":"patrol.dialogue0","startFrame":40,"endFrame":320,"speakerActor":"","speakerName":"Motobug","text":"Patrol... turn. Patrol... turn.","skinId":"moto","typerId":"moto","x":294,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"patrol.dialogue1","startFrame":420,"endFrame":560,"speakerActor":"","speakerName":"Motobug","text":"...","skinId":"moto","typerId":"moto","x":294,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"patrol.dialogue2","startFrame":570,"endFrame":730,"speakerActor":"","speakerName":"Motobug","text":"Thirty-five years of this.","skinId":"moto","typerId":"moto","x":294,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"patrol.dialogue3","startFrame":740,"endFrame":880,"speakerActor":"","speakerName":"Motobug","text":"I need a day off.","skinId":"moto","typerId":"moto","x":294,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"loop.dialogue0","startFrame":1200,"endFrame":1330,"speakerActor":"sonic","speakerName":"","text":"Uh... aren't you supposed to be chasing me?","skinId":"sonic","typerId":"sonic","x":170,"y":10,"width":300,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"loop.dialogue1","startFrame":1340,"endFrame":1430,"speakerActor":"","speakerName":"Motobug","text":"Day off.","skinId":"moto","typerId":"moto","x":10,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"loop.dialogue2","startFrame":1480,"endFrame":1580,"speakerActor":"sonic","speakerName":"","text":"...Huh. Fair enough.","skinId":"sonic","typerId":"sonic","x":294,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"island.dialogue0","startFrame":2040,"endFrame":2160,"speakerActor":"knuckles","speakerName":"","text":"Hey! No badniks on my island!","skinId":"knuckles","typerId":"knuckles","x":294,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"island.dialogue1","startFrame":2170,"endFrame":2260,"speakerActor":"","speakerName":"Motobug","text":"Day off.","skinId":"moto","typerId":"moto","x":10,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"island.dialogue2","startFrame":2280,"endFrame":2390,"speakerActor":"knuckles","speakerName":"","text":"...Badniks get days off?","skinId":"knuckles","typerId":"knuckles","x":294,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"island.dialogue3","startFrame":2400,"endFrame":2500,"speakerActor":"","speakerName":"Motobug","text":"They do now.","skinId":"moto","typerId":"moto","x":10,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"island.dialogue4","startFrame":2520,"endFrame":2630,"speakerActor":"knuckles","speakerName":"","text":"...Huh.","skinId":"knuckles","typerId":"knuckles","x":294,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"friends.dialogue0","startFrame":2780,"endFrame":2890,"speakerActor":"sonic","speakerName":"","text":"Room for one more?","skinId":"sonic","typerId":"sonic","x":10,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]},{"id":"friends.dialogue1","startFrame":2970,"endFrame":3070,"speakerActor":"tails","speakerName":"","text":"Make that two!","skinId":"tails","typerId":"tails","x":294,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"friends.dialogue2","startFrame":3120,"endFrame":3340,"speakerActor":"","speakerName":"Motobug","text":"Best. Day. Ever.","skinId":"moto","typerId":"moto","x":10,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"morning.dialogue0","startFrame":3420,"endFrame":3610,"speakerActor":"","speakerName":"Motobug","text":"Patrol... turn.","skinId":"moto","typerId":"moto","x":294,"y":10,"width":176,"height":40,"portraitAsset":"","revealFrames":[]},{"id":"morning.dialogue1","startFrame":3660,"endFrame":3830,"speakerActor":"","speakerName":"Motobug","text":"Only 364 days to go.","skinId":"moto","typerId":"moto","x":294,"y":10,"width":176,"height":52,"portraitAsset":"","revealFrames":[]}],"puppets":[{"actorId":"sonic","snapToFloor":true,"collisionPath":0,"commands":[{"id":"friends.sonic.action0","frame":2700,"kind":"MOVE_TO","x":4990.0,"y":1051.0,"urgency":0.6,"holdFrames":0,"target":{"layoutIndex":-1,"objectId":0,"subtype":0,"offsetX":0.0,"offsetY":0.0},"condition":"NONE","timeoutFrames":0,"motion":{"startingAction":"WALK","travelSpeed":"RUN","endingAction":"HARD_STOP","endingFacing":"INHERIT"}}]},{"actorId":"knuckles","snapToFloor":true,"collisionPath":0,"commands":[{"id":"island.knuckles.action0","frame":1940,"kind":"JUMP","x":0.0,"y":0.0,"urgency":0.0,"holdFrames":20,"target":{"layoutIndex":-1,"objectId":0,"subtype":0,"offsetX":0.0,"offsetY":0.0},"condition":"NONE","timeoutFrames":0,"motion":{"startingAction":"WALK","travelSpeed":"RUN","endingAction":"HARD_STOP","endingFacing":"INHERIT"}},{"id":"island.knuckles.action1","frame":1962,"kind":"GLIDE_TO","x":5160.0,"y":1051.0,"urgency":0.8,"holdFrames":0,"target":{"layoutIndex":-1,"objectId":0,"subtype":0,"offsetX":0.0,"offsetY":0.0},"condition":"NONE","timeoutFrames":0,"motion":{"startingAction":"WALK","travelSpeed":"RUN","endingAction":"HARD_STOP","endingFacing":"INHERIT"}}]},{"actorId":"tails","snapToFloor":true,"collisionPath":0,"commands":[{"id":"friends.tails.action0","frame":2790,"kind":"JUMP","x":0.0,"y":0.0,"urgency":0.0,"holdFrames":10,"target":{"layoutIndex":-1,"objectId":0,"subty